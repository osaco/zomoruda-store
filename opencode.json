{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "options": { "baseURL": "https://integrate.api.nvidia.com/v1", "apiKey": "{env:NVIDIA_API_KEY}", "timeout": 600000 },
      "models": {
        "deepseek-ai/deepseek-v4.1-flash": { "name": "DeepSeek V4.1 Flash", "limit": { "context": 128000, "output": 16000 } },
        "z-ai/glm-5.3": { "name": "GLM 5.3", "limit": { "context": 128000, "output": 16000 } }
      }
    }
  },
  "model": "nvidia/deepseek-ai/deepseek-v4.1-flash",
  "permission": { "edit": "allow", "bash": "allow", "webfetch": "allow" }
}
